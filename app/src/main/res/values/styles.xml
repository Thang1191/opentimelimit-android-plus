<resources>

    <!--
        Material 3 Expressive, applied at the token layer.

        Nearly every screen in this app (143 layouts) already reads its colours, shapes and text
        styles from theme attributes instead of hardcoding them — the fork never drifted into
        inline hex. That means the redesign lives here, in AppTheme, and reaches every screen
        without 143 separate edits. The one exception is PauseTheme, kept deliberately apart: it is
        its own black, on purpose, so a user mid-doomscroll recognises the gate as a different
        moment rather than another app screen.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="actionBarStyle">@style/AppActionBar</item>

        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Tertiary carries the signature move: the one hue in this app allowed to be loudest. -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Tonal elevation: surfaces step up through these instead of a drop shadow getting
             darker, so a raised card reads as "closer to you" rather than "dirtier". -->
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>

        <!-- Deprecated roles some older widgets still read; kept pointed at the same hues so
             nothing falls back to the pre-2026 purple. -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/md_tertiary</item>

        <!-- Expressive shape scale: bigger and rounder than stock M3's 4/8/12/16/28dp steps. This
             is the second half of the signature move — the app should feel soft and confident to
             tap, not clipped-corner-default. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.ExtraLarge</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="materialCardViewElevatedStyle">@style/Widget.App.CardView</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.App.CardView.Outlined</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>

        <!-- Expressive type: titles get real weight instead of medium-everywhere, so hierarchy is
             felt before it is read. Body and label roles are left at Material defaults — a screen
             the user reads line by line should not be fighting a display face. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>

        <item name="radioButtonStyle">@style/RadioButtonTheme</item>
        <item name="checkboxStyle">@style/CheckboxTheme</item>

        <item name="bottomSheetDialogTheme">@style/BottomSheetDialog</item>
    </style>

    <style name="AppThemeDarkOverlay" parent="ThemeOverlay.Material3.Dark">
        <item name="colorAccent">@color/white</item>
    </style>

    <style name="AppTheme.Translucent" parent="AppTheme">
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- from https://stackoverflow.com/a/46286184 -->
    <style name="BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSecondary">@color/md_tertiary</item>
        <item name="colorOnSecondary">@color/md_on_tertiary</item>
        <item name="colorAccent">@color/md_tertiary</item>
        <item name="radioButtonStyle">@style/RadioButtonTheme</item>
        <item name="checkboxStyle">@style/CheckboxTheme</item>

        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <!-- Bottom sheets get the biggest corner in the scale: they are the one component that visibly
         slides in from an edge, so the roundness is the whole entrance animation's shape. -->
    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="behavior_peekHeight">512dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet" parent="ShapeAppearance.App.ExtraLarge">
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="FullscreenDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSecondary">@color/md_tertiary</item>
        <item name="colorOnSecondary">@color/md_on_tertiary</item>
        <item name="colorAccent">@color/md_tertiary</item>
        <item name="radioButtonStyle">@style/RadioButtonTheme</item>
        <item name="checkboxStyle">@style/CheckboxTheme</item>

        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?colorSurface</item>
    </style>

    <style name="AppHomescreenTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- The pause is a screen, not a page: no app bar, its own black, and nothing that looks like
         the rest of Limited, because the point of the moment is that it is not the usual flow. -->
    <style name="PauseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#050208</item>
        <item name="android:statusBarColor">#050208</item>
        <item name="android:navigationBarColor">#050208</item>
        <item name="colorPrimary">#C7A6F2</item>
        <item name="colorOnPrimary">#12061C</item>
    </style>

    <style name="PauseImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="DangerButton" parent="Widget.App.Button">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
    </style>

    <style name="RadioButtonTheme" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="CheckboxTheme" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="AppActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?attr/colorSurface</item>
        <item name="titleTextStyle">@style/AppActionBarTitle</item>
    </style>

    <style name="AppActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============================== Shape scale ============================== -->
    <!-- M3 stock steps 4/8/12/16/28dp; this app steps 12/16/20/28/36dp. Rounder at every size, not
         just at the top: a checkbox's corner and a bottom sheet's corner should feel like the same
         idea at different scales. -->

    <style name="ShapeAppearance.App.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">36dp</item>
    </style>

    <!-- ============================== Components ============================== -->

    <!-- Pill buttons: the signature move's third half. A fully-rounded filled button is the app's
         one recognisable control shape, same way a card's corner radius is Material's. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Cards sit on a tonal surface a step above the background rather than casting much of a
         shadow — the depth is in the colour, Material's own answer to "elevation without gloom". -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <!-- ============================== Type ============================== -->
    <!-- Headlines get a heavier face and tighter tracking; body and labels stay at the Material
         default so reading copy never fights a display voice. -->

    <style name="TextAppearance.App.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
