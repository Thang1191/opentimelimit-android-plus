<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded horizontal progress track for the pause countdown; the stock platform
     ProgressBar draws square-ended bars, which read as a leftover system widget rather
     than a deliberate part of the screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#2A1E38" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#CDB8E8" />
            </shape>
        </clip>
    </item>
</layer-list>
