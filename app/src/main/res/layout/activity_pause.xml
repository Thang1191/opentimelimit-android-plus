<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050208">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- The picture *is* the check-in when the type is Pictures: it gets most of the screen and
                 the words underneath are a caption. As a faint background it was decoration, and
                 decoration is the one thing a speed bump cannot afford to be. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/pause_image"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/PauseImageShape" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Pause Point"
                android:textColor="#CDB8E8"
                android:textSize="13sp"
                android:letterSpacing="0.18"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/pause_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8A7C99"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pause_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#F2ECFA"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/pause_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#9C8DAE"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/pause_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="One line: what are you opening it for?"
                android:textColor="#F2ECFA"
                android:textColorHint="#6E627E"
                android:textSize="18sp"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:backgroundTint="#5A4B6E"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pause_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#CDB8E8"
                android:textSize="44sp"
                android:fontFamily="sans-serif-light" />

            <ProgressBar
                android:id="@+id/pause_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressTint="#9C7BD6"
                android:progressBackgroundTint="#33243F" />

            <Button
                android:id="@+id/pause_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Continue"
                android:textColor="#12061C"
                android:backgroundTint="#C7A6F2"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/pause_timer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/pause_timer_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 min"
                    android:backgroundTint="#3A2B4C"
                    android:textColor="#E8DCF6" />

                <Button
                    android:id="@+id/pause_timer_15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="15 min"
                    android:backgroundTint="#3A2B4C"
                    android:textColor="#E8DCF6" />

                <Button
                    android:id="@+id/pause_timer_30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="30 min"
                    android:backgroundTint="#3A2B4C"
                    android:textColor="#E8DCF6" />
            </LinearLayout>

            <Button
                android:id="@+id/pause_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Close"
                android:textColor="#9C8DAE"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
