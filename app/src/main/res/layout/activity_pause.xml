<?xml version="1.0" encoding="utf-8"?>
<!--
  Two exits, stacked at the bottom, deliberately unequal.

  Close is the loud one: full width, filled, sitting directly above Continue. Continue is a small
  unadorned line underneath it. Neither sits inside the scrolling area, so neither can be pushed
  below the fold by a tall picture — which is what made Close unreachable on the image check-in.

  The text/countdown block lives in a card: on the short check-ins (breath, timer) the scroll
  content was shorter than the screen, and since the ScrollView fills the remaining space, the
  content sat pinned to the top with a dead black gap above the buttons. The fillViewport trick
  below centers it instead, and the card gives the block a floor and walls instead of floating
  text on a void.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050208"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- When the check-in is Pictures the photo is the check-in: it gets the room, and the
                 words underneath are a caption. As a faint background it was decoration, and
                 decoration is the one thing a speed bump cannot afford to be. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/pause_image"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="24dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/PauseImageShape" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#150C20"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pause Point"
                        android:textColor="#9C8DAE"
                        android:textSize="12sp"
                        android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/pause_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#6E627E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/pause_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="#F2ECFA"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/pause_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#9C8DAE"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/pause_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="One line: what are you opening it for?"
                        android:textColor="#F2ECFA"
                        android:textColorHint="#6E627E"
                        android:textSize="17sp"
                        android:inputType="textCapSentences"
                        android:maxLines="3"
                        android:backgroundTint="#5A4B6E"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/pause_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:textColor="#E3D6F7"
                        android:textSize="48sp"
                        android:fontFamily="sans-serif-black" />

                    <ProgressBar
                        android:id="@+id/pause_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressDrawable="@drawable/pause_progress_track" />

                    <LinearLayout
                        android:id="@+id/pause_timer_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/pause_timer_5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="5 min"
                            android:textSize="14sp"
                            android:backgroundTint="#2A1E38"
                            android:textColor="#D8C9EC"
                            app:cornerRadius="14dp" />

                        <Button
                            android:id="@+id/pause_timer_15"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="15 min"
                            android:textSize="14sp"
                            android:backgroundTint="#2A1E38"
                            android:textColor="#D8C9EC"
                            app:cornerRadius="14dp" />

                        <Button
                            android:id="@+id/pause_timer_30"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="30 min"
                            android:textSize="14sp"
                            android:backgroundTint="#2A1E38"
                            android:textColor="#D8C9EC"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- The loud exit sits on top of the quiet one: Close above, Continue below. -->
    <Button
        android:id="@+id/pause_close"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:text="Close"
        android:textSize="18sp"
        android:textColor="#12061C"
        android:backgroundTint="#C7A6F2"
        app:cornerRadius="18dp" />

    <!-- The way in: quiet, small, and underneath the way out. -->
    <Button
        android:id="@+id/pause_continue"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:text="Continue anyway"
        android:textSize="14sp"
        android:textColor="#8A7C99"
        android:backgroundTint="#00000000"
        android:visibility="invisible"
        app:strokeWidth="0dp" />
</LinearLayout>
