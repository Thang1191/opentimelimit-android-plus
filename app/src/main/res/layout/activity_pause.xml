<?xml version="1.0" encoding="utf-8"?>
<!--
  Pause Point.

  Rebuilt with two references in hand: Material 3 Expressive for every component and token decision
  (m3-expressive skill: references/tokens.md, references/component-tokens.md,
  references/components/feedback.md), and the craft floor for what to avoid (impeccable,
  reference/craft-floor.md).

  What the composition is, top to bottom:

  1. The picture. It is the check-in, not wallpaper behind one, so it takes every dp the rest of
     the column does not need and is always the largest thing on screen.
  2. One line under it. For the pictures check-in this is a prompt that rotates each pause
     ("Remember this?") unless the category has its own copy set.
  3. A circular countdown. A real M3 CircularProgressIndicator doing a real job: determinate,
     Primary active indicator on a Secondary container track, 120dp indicator size (the component's
     documented range is 24–240dp), 6dp track — thicker than the 4dp default, which is the
     configurable track thickness M3 Expressive added. The craft floor refuses rings standing in for
     content; this ring *is* the content, and the brief asked for it by name.
  4. Both exits, stacked at the bottom. Close is the loud one — full width, filled, 56dp
     (ButtonMedium) on CornerFull. Continue sits directly under it, text-only and 40dp
     (ButtonSmall). Neither is a kicker: there is no small label floating above a heading, because
     the picture is the heading.

  No ScrollView. The column is laid out to fit a 363×800dp phone by construction — the picture
  absorbs the slack through layout_weight, so there is nothing left to scroll and nothing can be
  pushed off the bottom. A previous version put this inside a ScrollView, where a weighted child
  measured against an unconstrained height and the countdown ended up clipped 283px past the
  viewport.

  Shape carries the expression instead of decoration: one 28dp CornerExtraLarge rectangle against
  one full circle, and nothing else needs a gradient, a glow or an outlined pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0612"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- The picture takes whatever height the rest of the column does not need. minHeight stops it
         being squeezed out of existence when the system font is scaled up. CornerExtraLarge = 28dp. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/pause_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/PausePointImageShape" />

    <TextView
        android:id="@+id/pause_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#EDE6F5"
        android:textSize="22sp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/pause_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textColor="#B3AAC4"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/pause_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="One line: what are you opening it for?"
        android:textColor="#EDE6F5"
        android:textColorHint="#B3AAC4"
        android:textSize="16sp"
        android:inputType="textCapSentences"
        android:maxLines="3"
        android:backgroundTint="#453E58"
        android:visibility="gone" />

    <!-- The countdown. Drawn by CountdownRing so the ring is centred on its view by construction:
         Material's CircularProgressIndicator put its arc about 2dp off-centre with the track
         touching the view edge, which reads as misaligned and clipped. Digits sit in the middle
         because the ring exists to frame them, and tabular figures keep the number from shifting
         sideways as it counts. The 7dp translation drops the block so the *number* lands on the
         ring's centre with the unit hanging below it, instead of the pair being centred as a block
         and the number riding high. -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp">

        <io.timelimit.android.ui.pause.CountdownRing
            android:id="@+id/pause_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:translationY="7dp">

            <TextView
                android:id="@+id/pause_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:includeFontPadding="false"
                android:textColor="#EDE6F5"
                android:textSize="36sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_gravity="center_horizontal"
                android:includeFontPadding="false"
                android:text="sec"
                android:textColor="#B3AAC4"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </FrameLayout>

    <!-- Timer check-in: ButtonSmall (40dp) tonal buttons on CornerFull. -->
    <LinearLayout
        android:id="@+id/pause_timer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/pause_timer_5"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="5 min"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#E9DDFF"
            android:backgroundTint="#453E58"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/pause_timer_15"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="15 min"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#E9DDFF"
            android:backgroundTint="#453E58"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/pause_timer_30"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="30 min"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#E9DDFF"
            android:backgroundTint="#453E58"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- Close: ButtonMedium, 56dp, CornerFull, Primary / on Primary. -->
    <Button
        android:id="@+id/pause_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Close"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textColor="#38007A"
        android:backgroundTint="#CFBCFF"
        app:cornerRadius="28dp" />

    <!-- Continue: ButtonSmall, 40dp, text only. Quiet through size and the absence of a container,
         not through contrast — #B3AAC4 on this surface still clears 4.5:1. -->
    <Button
        android:id="@+id/pause_continue"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:minWidth="0dp"
        android:paddingHorizontal="20dp"
        android:text="Continue anyway"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="#B3AAC4"
        android:background="@null"
        android:visibility="invisible" />
</LinearLayout>
